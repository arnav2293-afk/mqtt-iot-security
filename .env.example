# Copy this file to .env and change the passwords. .env is git-ignored.

# Which broker config to run: phase1_open, phase2_auth, phase3_tls, phase4_acl
PHASE=phase1_open

MQTT_HOST=localhost
MQTT_TOPIC=sensors/lab1/temperature

# Lab-only throwaway passwords. Never reuse a real password here.
SENSOR_USER=sensor01
SENSOR_PASS=change-me-sensor
DASHBOARD_USER=dashboard
DASHBOARD_PASS=change-me-dashboard
